    - -ID:/gtaspscqueue/plugin-sdk/shared/comp
    - -ID:/gtaspscqueue/plugin-sdk/shared/comp/plugins
    - -ID:/gtaspscqueue/plugin-sdk/shared/dxsdk
    - -ID:/gtaspscqueue/plugin-sdk/shared/extender
    - -ID:/gtaspscqueue/plugin-sdk/shared/extensions
